{
  "name": "prolyfix/h-t_module_online-calendar",
  "description": "Online Calendar Bundle for Holiday and Time",
  "type": "symfony-bundle",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Prolyfix\\OnlineCalendarBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Prolyfix\\OnlineCalendarBundle\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Marc Baudot",
      "email": "marc.baudot@macareux.de"
    }
  ],
  "minimum-stability": "dev",
  "require": {
    "php": ">=8.2",
    "doctrine/collections": "^2.2",
    "symfony/console": "^7.3",
    "symfony/messenger": "^7.3",
    "symfony/scheduler": "^7.3",
    "symfony/webpack-encore-bundle": "^2.0",
    "symfony/stimulus-bundle": "^2.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    }
  }
}
